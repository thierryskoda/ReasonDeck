// Copy this file to Local.xcconfig and keep that file untracked.
// Use one stable team for builds that need macOS privacy grants. Xcode creates a
// free Apple Development certificate once you sign in under Xcode > Settings > Accounts.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Do not fall back to ad-hoc signing (CODE_SIGN_IDENTITY = -) for builds you grant
// permissions to. An ad-hoc build is identified only by its binary hash, so macOS
// treats every rebuild as a new app and silently drops Accessibility and Input
// Monitoring grants while System Settings still shows the toggle on. Settings warns
// when the running build has this problem.

// The tracked bundle identifier is intentionally stable. Override it only when
// you deliberately want a separate development identity and separate grants.
// APP_BUNDLE_IDENTIFIER = com.example.ReasonDeck
